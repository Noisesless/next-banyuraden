# ==============================================================================
# PORTAL KALURAHAN BANYURADEN — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Salin file ini menjadi .env / .env.local dan sesuaikan nilai rahasia Anda.
# JANGAN PERNAH meng-commit file .env atau .env.local ke repositori publik!

# Database Connection (MySQL / MariaDB)
DATABASE_URL="mysql://banyuraden_user:your_strong_password@localhost:3306/banyuraden"

# Authentication Secrets (Generate with: openssl rand -base64 32)
AUTH_SECRET="generate_with_openssl_rand_base64_32"
NEXTAUTH_SECRET="generate_with_openssl_rand_base64_32"
NEXTAUTH_URL="https://banyuraden.smartdesa.net"

# Public App URL
NEXT_PUBLIC_SITE_URL="https://banyuraden.smartdesa.net"

# Upstream OpenSID & Village Portal Base URLs
OPENSID_API_PRIMARY="https://banyuraden.sleman-desa.id"
OPENSID_API_FALLBACK="https://banyuraden.sleman-desa.id"

# Server Port (Default Next.js: 5091)
PORT=5091
